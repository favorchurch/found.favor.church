# Supabase (public catalog uses the anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Admin data access, used after the MNL Staff check passes. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Auth0 (reuses the existing Favor Church applications; register <APP_BASE_URL>/auth/callback
# as a callback URL and <APP_BASE_URL> as a logout URL on the application)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=

# Rock (MNL Staff membership check)
ROCK_API_URL=
ROCK_API_KEY=
ROCK_MNL_STAFF_GROUP_ID=
